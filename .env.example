# VisionFit AI Environment Variables
# Copy this file to .env for local development

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
# Generate a secure random string for production
SESSION_SECRET=your-secret-key-change-this

# Database Configuration
DATABASE_URL=sqlite:///visionfit.db

# Google Gemini API Key (get one at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-gemini-api-key

# Sarvam AI (https://www.sarvam.ai) - powers the bilingual voice assistant
# Set this in your local .env (do NOT commit real keys)
SARVAM_API_KEY=your-sarvam-api-key

# Google Fit Configuration (OAuth 2.0)
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/oauth2callback

# Port Configuration
PORT=5000
